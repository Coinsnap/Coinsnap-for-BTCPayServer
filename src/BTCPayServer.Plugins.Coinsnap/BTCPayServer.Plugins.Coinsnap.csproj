<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <!-- Reproducible restores: packages.lock.json pins every package, and CI refuses any drift. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Product>Coinsnap Wallet for BTCPay Server</Product>
    <Description>Receive Lightning payments directly into a Coinsnap Wallet using a Lightning Address.</Description>
    <Version>0.1.0</Version>
    <!-- Without the +commit suffix BTCPay parses this and shows 0.1.0 rather than 0.1.0.0. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>Coinsnap</Company>
    <Copyright>Copyright © 2026 Coinsnap</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Coinsnap/coinsnap-wallet-btcpay-plugin</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RootNamespace>BTCPayServer.Plugins.Coinsnap</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <PreserveCompilationContext>false</PreserveCompilationContext>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ProjectReference>
      <Properties>StaticWebAssetsEnabled=false</Properties>
      <Private>false</Private>
      <ExcludeAssets>runtime;native;build;buildTransitive;contentFiles</ExcludeAssets>
    </ProjectReference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ProjectReference Include="../../submodules/btcpayserver/BTCPayServer/BTCPayServer.csproj" />
    <EmbeddedResource Include="Resources/**" />
    <AdditionalFiles Include="Views/Shared/Coinsnap/*.cshtml" />
    <InternalsVisibleTo Include="BTCPayServer.Plugins.Coinsnap.Tests" />
  </ItemGroup>
</Project>
