<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Reproducible restores: packages.lock.json pins every package, and CI refuses any drift. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime;build;native;contentfiles;analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/BTCPayServer.Plugins.Coinsnap/BTCPayServer.Plugins.Coinsnap.csproj" />
    <!-- Same global properties as the plugin's reference, so BTCPay is built once, not twice into one obj. -->
    <ProjectReference Include="../../submodules/btcpayserver/BTCPayServer/BTCPayServer.csproj">
      <Private>true</Private>
      <Properties>StaticWebAssetsEnabled=false</Properties>
    </ProjectReference>
  </ItemGroup>
</Project>
