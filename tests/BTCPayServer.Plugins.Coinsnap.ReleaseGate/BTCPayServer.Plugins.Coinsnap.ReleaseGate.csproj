<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Reproducible restores: packages.lock.json pins every package, and CI refuses any drift. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime;build;native;contentfiles;analyzers</IncludeAssets>
    </PackageReference>
    <!-- BOLT11 parsing independent of the plugin, so a parser bug cannot pass its own test. -->
    <PackageReference Include="BTCPayServer.Lightning.All" Version="1.7.7" />
    <!-- Same version as BTCPay's own UI tests, so one browser install serves both. -->
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
    <!-- Resets the gate's own database so every run starts from the same state. -->
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>
</Project>
